// Prisma schema for Abbay TV Sales Automation System
// PostgreSQL database - Single tenant system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER - System users with roles and permissions
// ============================================
model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  phoneNumber           String   @unique @map("phone_number")
  telegramUsername      String?  @unique @map("telegram_username")
  passwordHash          String   @map("password_hash")
  fullName              String   @map("full_name")
  sex                   String   @map("sex")
  roles                 String[] // Array of UserRole enum values
  isActive              Boolean  @default(true) @map("is_active")
  isFirstTimeAccount    Boolean  @default(false) @map("is_first_time_account")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  telegramGroupMemberships TelegramGroupMember[]
  userPermissions          UserPermission[]  @relation("UserPermissions")
  permissionsGranted       UserPermission[]  @relation("PermissionGranter")

  @@index([email])
  @@map("users")
}

// ============================================
// SHOW - TV shows (InHouse or Outsourced)
// ============================================
model Show {
  id                 String   @id @default(uuid())
  title              String
  type               String // ShowType enum: 'InHouse' | 'Outsourced'
  durationMinutes    Int      @map("duration_minutes")
  maxAdLengthSeconds Int      @map("max_ad_length_seconds")
  schedule           Json     @default("[]") // Array of { day, startTime, endTime }
  assignedStaff      String?  @map("assigned_staff")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  adverts       Advert[]
  satelliteLogs SatelliteLog[]

  @@map("shows")
}

// ============================================
// CUSTOMER - Advertiser companies
// ============================================
model Customer {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  contacts  Json     @default("[]") // Array of { name, email?, phone? }
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  adverts Advert[]

  @@map("customers")
}

// ============================================
// ADVERT - Advertisement campaigns
// ============================================
model Advert {
  id              String   @id @default(uuid())
  showId          String   @map("show_id")
  customerId      String   @map("customer_id")
  status          String // AdvertStatus enum: Draft, Scheduled, Active, Completed, Failed
  slot            Json?    // { start: DateTime, end: DateTime }
  contractDetails String?  @map("contract_details")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  show          Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments      Payment[]
  compensations Compensation[]

  @@index([showId])
  @@index([customerId])
  @@index([status])
  @@map("adverts")
}

// ============================================
// PARTNER - External partners for outsourced shows
// ============================================
model Partner {
  id           String   @id @default(uuid())
  name         String
  revenueShare Json     // { value: number } - Percentage value object
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

// ============================================
// PAYMENT - Financial transactions
// ============================================
model Payment {
  id               String   @id @default(uuid())
  advertId         String   @map("advert_id")
  installmentLabel String?  @map("installment_label")
  amount           Json     // { amount: number, currency: string } - Money value object
  dueDate          DateTime @map("due_date")
  status           String // PaymentStatus enum: Pending, Sent, Overdue, Paid, Failed
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  advert Advert @relation(fields: [advertId], references: [id], onDelete: Cascade)

  @@index([advertId])
  @@index([status])
  @@map("payments")
}

// ============================================
// COMPENSATION - Missed ad compensation records
// ============================================
model Compensation {
  id               String   @id @default(uuid())
  advertId         String   @map("advert_id")
  proposal         String
  status           String // 'Proposed' | 'Accepted' | 'Rejected'
  customerResponse String?  @map("customer_response")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  advert Advert @relation(fields: [advertId], references: [id], onDelete: Cascade)

  @@index([advertId])
  @@map("compensations")
}

// ============================================
// SATELLITE LOG - Broadcast verification logs
// ============================================
model SatelliteLog {
  id           String   @id @default(uuid())
  showId       String   @map("show_id")
  broadcastAt  DateTime @map("broadcast_at")
  deliveredAds Json     @default("[]") // Array of { advertId, played: boolean }
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([showId])
  @@map("satellite_logs")
}

// ============================================
// MEDIA PACK - Advertising packages with versioning
// ============================================
model MediaPack {
  id          String   @id @default(uuid())
  name        String
  description String?
  versions    Json     @default("[]") // Array of { version: number, notes?, createdAt }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("media_packs")
}

// ============================================
// TELEGRAM GROUP - Telegram notification groups
// ============================================
model TelegramGroup {
  id          String   @id @default(uuid())
  groupName   String   @map("group_name")
  groupChatId String?   @unique @map("group_chat_id")
  groupLink   String  @map("group_link")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  members TelegramGroupMember[]

  @@map("telegram_groups")
}

// ============================================
// TELEGRAM GROUP MEMBER - Junction table for User-TelegramGroup
// ============================================
model TelegramGroupMember {
  id              String   @id @default(uuid())
  telegramGroupId String   @map("telegram_group_id")
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  telegramGroup TelegramGroup @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([telegramGroupId, userId]) // Prevent duplicate memberships
  @@index([telegramGroupId])
  @@index([userId])
  @@map("telegram_group_members")
}


// ============================================
// PERMISSION - Permission for authorizations
// ============================================
model Permission {
  id                  String   @id @default(uuid())
  name                String
  nameSlug            String   @unique @map("name_slug")
  isSystemPermission  String? @map("is_system_permission")
  description         String?   
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  userPermissions UserPermission[]
}


// ============================================
// USER PERMISSION - Junction table for User-Permission
// ============================================
model UserPermission {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  permissionId    String   @map("permission_id")
  grantedBy       String?  @map("granted_by")
  expiresAt       DateTime?   @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user          User          @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser User?         @relation("PermissionGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([permissionId, userId]) // Prevent duplicate permissions
  @@index([permissionId])
  @@index([userId])
  @@map("user_permissions")
}