// Prisma schema for Abbay TV Sales Automation System
// PostgreSQL database - Single tenant system

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRefModel {
  Partner
  Employee
  Internal
}

enum SalesCommissionType {
  Percentage
  Fixed
}

// ============================================
// USER - System users with roles and permissions
// ============================================
model User {
  id                    String       @id @default(uuid())
  email                 String       @unique
  phoneNumber           String       @unique @map("phone_number")
  telegramUsername      String?      @unique @map("telegram_username")
  passwordHash          String       @map("password_hash")
  fullName              String       @map("full_name")
  sex                   String       @map("sex")
  roles                 String[]     // Array of UserRole enum values
  isActive              Boolean      @default(true) @map("is_active")
  isFirstTimeAccount    Boolean      @default(false) @map("is_first_time_account")
  refModel              UserRefModel @default(Internal) @map("ref_model")
  partnerId             String?      @unique @map("partner_id")
  employeeId            String?      @unique @map("employee_id")
  salesCommissionType   SalesCommissionType? @map("sales_commission_type")
  salesCommissionAmount Float?       @map("sales_commission_amount")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  // Relations
  partner               Partner?     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  employee              Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  telegramGroupMemberships TelegramGroupMember[]
  userPermissions          UserPermission[]  @relation("UserPermissions")
  permissionsGranted       UserPermission[]  @relation("PermissionGranter")
  showHosts                ShowHost[]
  communicationLogs        CommunicationLog[] @relation("CommunicationLogSalesAgent")
  customersAsSalesAgent     Customer[]         @relation("CustomerSalesAgent")
  advertSalesAsSalesRep     AdvertSales[]      @relation("AdvertSalesSalesRep")
  advertSalesAsSalesAgent   AdvertSales[]      @relation("AdvertSalesSalesAgent")
  compensationsProposed     Compensation[]     @relation("CompensationProposedBy")
  satelliteLogUploads       SatelliteLogUpload[] @relation("SatelliteLogUploader")
  agentCommissions          AgentCommission[]    @relation("AgentCommissions")

  @@index([email])
  @@index([refModel])
  @@map("users")
}

// ============================================
// SHOW - TV shows (InHouse or Outsourced)
// ============================================
model Show {
  id                 String   @id @default(uuid())
  title              String
  titleSlug          String   @unique @map("titel_slug")
  type               String   // ShowType enum: 'InHouse' | 'Outsourced'
  durationMinutes    Int      @map("duration_minutes")
  maxAdLengthMinutes Int      @map("max_ad_length_minutes")
  totalDurationMinutes Int    @map("total_duration_minutes")
  partsCount         Int      @map("parts_count")
  rerunsCount        Int      @default(0) @map("reruns_count")
  bonusCount         Int      @default(0) @map("bonus_count")
  colorForScheduleBlock String? @map("color_for_schedule_block")
  status             String   @default("Draft") // Status enum: 'Draft' | 'Active' | 'Archived' | 'InActive'
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  advertPlacements   AdvertPlacement[]
  scheduleBlocks     SatelliteScheduleBlock[]
  broadcastSlots     BroadcastSlot[]

  showHosts          ShowHost[]

  // Relations
  advertPackageLinks AdvertPackageShow[]
  showSegmentSlots   ShowSegmentSlot[]

  @@map("shows")
}

// ============================================
// SHOW HOST - Junction table between Show and User with revenue share
// ============================================
model ShowHost {
  id               String           @id @default(uuid())
  showId           String           @map("show_id")
  userId           String           @map("user_id")
  revenueShareType String?          @map("revenue_share_type")
  revenueShareValue Int?            @map("revenue_share_value")
  isPrimary        Boolean          @default(false) @map("is_primary")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  show             Show             @relation(fields: [showId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([showId, userId])
  @@index([showId])
  @@index([userId])
  @@map("show_hosts")
}

// ============================================
// CATEGORY - Customer/company category (e.g., Finance, Food)
// ============================================
model Category {
  id        String   @id @default(uuid())
  name      String
  nameSlug  String   @unique @map("name_slug")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  subCategories SubCategory[]
  customers     Customer[]
  advertSales   AdvertSales[]

  @@map("categories")
}

// ============================================
// SUB CATEGORY - Sub-category under a category (e.g., BANK under Finance)
// ============================================
model SubCategory {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  name       String
  nameSlug   String   @map("name_slug")
  isCustom   Boolean  @default(false) @map("is_custom")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  customers   Customer[]
  advertSales AdvertSales[]

  @@unique([categoryId, nameSlug])
  @@index([categoryId])
  @@map("sub_categories")
}

// ============================================
// CUSTOMER - Advertiser companies (Sales Follow-up)
// ============================================
model Customer {
  id                        String    @id @default(uuid())
  businessRef               String    @unique @map("business_ref")
  name                      String
  industry                  String?
  contacts                  Json      @default("[]") // Array of { name, email?, phone?, position?, mobile?, officeTel? }
  categoryId                String?   @map("category_id")
  subCategoryId             String?   @map("sub_category_id")
  location                  String?
  salesAgentId              String?   @map("sales_agent_id")
  nextReviewDate            DateTime? @map("next_review_date")
  status                    String?   // Cold Progress, Hot Progress, Partner, etc.
  holidayStatus             String?   @map("holiday_status") // Interested, Not Interested, etc.
  studioVisit               String?   @map("studio_visit") // Visited Studio, Not Visited Studio
  otherMediaCampaign        String?   @map("other_media_campaign")
  sourceFromMediaMonitoring Boolean   @default(false) @map("source_from_media_monitoring")
  mediaMonitoringSourceId   String?   @unique @map("media_monitoring_id")
  inPersonUpdate            DateTime? @map("in_person_update")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  // Relations
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory        SubCategory?        @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  salesAgent         User?               @relation("CustomerSalesAgent", fields: [salesAgentId], references: [id], onDelete: SetNull)
  mediaMonitoringSource MediaMonitoringRecord? @relation("CustomerBirthSource", fields: [mediaMonitoringSourceId], references: [id], onDelete: SetNull)
  communicationLogs  CommunicationLog[]
  mediaMonitoringRecords MediaMonitoringRecord[] @relation("CustomerLinkedMonitoringRecords")
  showSegmentSlots    ShowSegmentSlot[]
  advertSales         AdvertSales[]

  @@index([businessRef])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([salesAgentId])
  @@index([status])
  @@map("customers")
}

// ============================================
// COMMUNICATION LOG - Write-only customer communication history
// ============================================
model CommunicationLog {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  logDate      DateTime @map("log_date")
  salesAgentId String   @map("sales_agent_id")
  notes        String
  mediaPackId  String?  @map("media_pack_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesAgent User      @relation("CommunicationLogSalesAgent", fields: [salesAgentId], references: [id], onDelete: Restrict)
  mediaPack  MediaPack? @relation(fields: [mediaPackId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([salesAgentId])
  @@index([logDate])
  @@index([mediaPackId])
  @@map("communication_logs")
}

// ============================================
// MEDIA MONITORING RECORD - Competitor advertiser tracking
// ============================================
model MediaMonitoringRecord {
  id               String   @id @default(uuid())
  channel          String   // EBS, FANA, Arts, Kana, Radio
  sponsorName      String   @map("sponsor_name")
  showName         String?  @map("show_name")
  timeSlot         String?  @map("time_slot")
  monitoringDate   DateTime @map("monitoring_date")
  statusWithUs  String?  @map("status_with_abbay") // Cold progress, Partner, NEW, etc.
  contactInfo      String?  @map("contact_info") // For Radio: phone number
  customerId       String?  @map("customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations: many records per customer (linked rows); optional reverse of birth FK on Customer
  customer              Customer? @relation("CustomerLinkedMonitoringRecords", fields: [customerId], references: [id], onDelete: SetNull)
  customerAsBirthSource Customer? @relation("CustomerBirthSource")

  @@index([channel])
  @@index([customerId])
  @@index([sponsorName])
  @@map("media_monitoring_records")
}

// ============================================
// SHOW SEGMENT SLOT - Customer segment assignment per show
// ============================================
model ShowSegmentSlot {
  id         String   @id @default(uuid())
  showId     String   @map("show_id")
  customerId String   @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  show     Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([showId, customerId])
  @@index([showId])
  @@index([customerId])
  @@map("show_segment_slots")
}

// ============================================
// ADVERT PLACEMENT - Individual scheduled ad spots linked to a sale
// ============================================
model AdvertPlacement {
  id                 String    @id @default(uuid())
  advertSalesId      String    @map("advert_sales_id")
  showId             String    @map("show_id")
  broadcastSlotId    String?   @map("broadcast_slot_id")
  date               DateTime
  dateEth            String    @map("date_eth")
  position           String    // Beginning | Middle | End
  spotIndex          Int       @default(1) @map("spot_index")
  broadcastCode      String?   @map("broadcast_code")
  plannedTimeMinutes Int?      @map("planned_time_minutes")
  actualAirTime      DateTime? @map("actual_air_time")
  durationSeconds    Int       @map("duration_seconds")
  status             String    @default("SCHEDULED") // SCHEDULED, AIRED, MISSED, COMPENSATED, CANCELLED
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  advertSales         AdvertSales       @relation(fields: [advertSalesId], references: [id], onDelete: Cascade)
  show                Show              @relation(fields: [showId], references: [id], onDelete: Cascade)
  broadcastSlot       BroadcastSlot?    @relation(fields: [broadcastSlotId], references: [id], onDelete: SetNull)
  compensations       Compensation[]
  satelliteLogEntries SatelliteLogEntry[]

  @@index([advertSalesId])
  @@index([showId])
  @@index([broadcastSlotId])
  @@index([date])
  @@index([status])
  @@map("advert_placements")
}

// ============================================
// PARTNER - External partners for outsourced shows
// ============================================
model Partner {
  id           String   @id @default(uuid())
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user          User?
  revenueShares RevenueShare[]
  @@map("partners")
}

// ============================================
// EMPLOYEE - Internal staff (sales, managers)
// ============================================
model Employee {
  id                    String                @id @default(uuid())
  employeeNumber        String?               @unique @map("employee_number")
  department            String?
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  user User?
  @@map("employees")
}

// ============================================
// PAYMENT - Financial transactions linked to an advert sale
// ============================================
model Payment {
  id                    String    @id @default(uuid())
  advertSalesId         String    @map("advert_sales_id")
  paymentRequestRef     String?   @unique @map("payment_request_ref")
  installmentNumber     Int       @default(1) @map("installment_number")
  installmentLabel      String?   @map("installment_label")
  amountBeforeVat       Float     @default(0) @map("amount_before_vat")
  vatAmount             Float     @default(0) @map("vat_amount")
  withholdTax           Float     @default(0) @map("withhold_tax")
  vatWithhold           Float     @default(0) @map("vat_withhold")
  totalAmount           Float     @default(0) @map("total_amount")
  bankDeposit           Float     @default(0) @map("bank_deposit")
  balance               Float     @default(0)
  dueDate               DateTime  @map("due_date")
  paymentDate           DateTime? @map("payment_date")
  paymentMethod         String?   @map("payment_method")
  bankDepositDate       DateTime? @map("bank_deposit_date")
  bankConfirmation      String?   @map("bank_confirmation")
  fsNumber              String?   @map("fs_number")
  requestSentDate       DateTime? @map("request_sent_date")
  status                String    @default("Pending") // PaymentStatus: Pending, Sent, Overdue, Paid, Failed
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  advertSales AdvertSales @relation(fields: [advertSalesId], references: [id], onDelete: Cascade)

  @@index([advertSalesId])
  @@index([status])
  @@map("payments")
}

// ============================================
// COMPENSATION - Missed ad compensation records linked to an advert sale
// ============================================
model Compensation {
  id                  String    @id @default(uuid())
  advertSalesId       String    @map("advert_sales_id")
  advertPlacementId   String?   @map("advert_placement_id")
  proposal            String
  missedDate          DateTime? @map("missed_date")
  compensationType    String?   @map("compensation_type") // ExtraSlot, Discount, Refund
  compensationDetails Json?     @map("compensation_details")
  proposedById        String?   @map("proposed_by_id")
  status              String    // Proposed, Accepted, Rejected
  customerResponse    String?   @map("customer_response")
  respondedAt         DateTime? @map("responded_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  advertSales     AdvertSales     @relation(fields: [advertSalesId], references: [id], onDelete: Cascade)
  advertPlacement AdvertPlacement? @relation(fields: [advertPlacementId], references: [id], onDelete: SetNull)
  proposedBy      User?           @relation("CompensationProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)

  @@index([advertSalesId])
  @@index([advertPlacementId])
  @@map("compensations")
}

// ============================================
// SATELLITE SCHEDULE - Schedule definitions (effective date range, type)
// ============================================
model SatelliteSchedule {
  id               String   @id @default(uuid())
  name             String
  nameSlug         String   @unique @map("name_slug")
  effectiveFrom    DateTime @map("effective_from")
  effectiveTo      DateTime @map("effective_to")
  effectiveFromEth DateTime?  @map("effective_from_eth")
  effectiveToEth   DateTime?  @map("effective_to_eth")
  status           String   @default("DRAFT") // SatelliteScheduleStatus: DRAFT | ACTIVE | ARCHIVED
  scheduleType     String   @map("schedule_type") // SatelliteScheduleType: Regular | Holiday
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  blocks         SatelliteScheduleBlock[]
  broadcastSlots BroadcastSlot[]

  @@map("satellite_schedules")
}

// ============================================
// SATELLITE SCHEDULE BLOCK - Weekly time-slot template for a show within a schedule
// ============================================
model SatelliteScheduleBlock {
  id               String   @id @default(uuid())
  scheduleId       String   @map("schedule_id")
  showId           String   @map("show_id")
  dayOfWeek        String   @map("day_of_week")        // DayOfWeek enum: MONDAY..SUNDAY
  startTimeMinutes Int      @map("start_time_minutes")  // Gregorian minutes from midnight (e.g. 360 = 06:00)
  durationMinutes  Int      @map("duration_minutes")
  broadcastType    String   @map("broadcast_type")      // BroadcastType enum
  label            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  schedule       SatelliteSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  show           Show              @relation(fields: [showId], references: [id], onDelete: Cascade)
  broadcastSlots BroadcastSlot[]

  @@unique([scheduleId, dayOfWeek, startTimeMinutes])
  @@index([scheduleId])
  @@index([showId])
  @@map("satellite_schedule_blocks")
}

// ============================================
// BROADCAST SLOT - Date-specific occurrence materialized from a ScheduleBlock template
// ============================================
model BroadcastSlot {
  id               String   @id @default(uuid())
  scheduleBlockId  String   @map("schedule_block_id")
  scheduleId       String   @map("schedule_id")
  showId           String   @map("show_id")
  date             DateTime
  dateEth          String   @map("date_eth")
  dayOfWeek        String   @map("day_of_week")
  startTimeMinutes Int      @map("start_time_minutes")
  durationMinutes  Int      @map("duration_minutes")
  broadcastType    String   @map("broadcast_type")
  label            String?
  status           String   @default("SCHEDULED")
  overrideReason   String?  @map("override_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  scheduleBlock SatelliteScheduleBlock @relation(fields: [scheduleBlockId], references: [id], onDelete: Cascade)
  schedule      SatelliteSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  show          Show                   @relation(fields: [showId], references: [id], onDelete: Cascade)
  advertPlacements AdvertPlacement[]

  @@unique([scheduleBlockId, date])
  @@index([scheduleId])
  @@index([showId])
  @@index([date])
  @@index([status])
  @@map("broadcast_slots")
}

// ============================================
// SATELLITE LOG UPLOAD - Raw log file upload records
// ============================================
model SatelliteLogUpload {
  id           String   @id @default(uuid())
  logDate      DateTime @map("log_date")
  uploadedById String   @map("uploaded_by_id")
  fileName     String   @map("file_name")
  status       String   @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploadedBy User                @relation("SatelliteLogUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  entries    SatelliteLogEntry[]

  @@index([logDate])
  @@index([uploadedById])
  @@map("satellite_log_uploads")
}

// ============================================
// SATELLITE LOG ENTRY - Individual parsed log entries
// ============================================
model SatelliteLogEntry {
  id                    String    @id @default(uuid())
  satelliteLogUploadId  String    @map("satellite_log_upload_id")
  broadcastDateTime     DateTime  @map("broadcast_date_time")
  hexId                 String    @map("hex_id")
  description           String
  durationSeconds       Int       @map("duration_seconds")
  matchedPlacementId    String?   @map("matched_placement_id")
  matchType             String    @default("UNMATCHED") @map("match_type") // AUTO, MANUAL, UNMATCHED
  createdAt             DateTime  @default(now()) @map("created_at")

  upload           SatelliteLogUpload @relation(fields: [satelliteLogUploadId], references: [id], onDelete: Cascade)
  matchedPlacement AdvertPlacement?   @relation(fields: [matchedPlacementId], references: [id], onDelete: SetNull)

  @@index([satelliteLogUploadId])
  @@index([matchedPlacementId])
  @@index([broadcastDateTime])
  @@map("satellite_log_entries")
}

// ============================================
// MEDIA PACK - Advertising packages with versioning
// ============================================
model MediaPack {
  id             String          @id @default(uuid())
  version        String
  versionSlug    String          @unique @map("version_slug")
  description    String?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  advertPackageMediaPackLinks    AdvertPackageMediaPack[]
  communicationLogs            CommunicationLog[]

  @@map("media_packs")
}

// ============================================
// ADVERT PACKAGE - Links to media packs via AdvertPackageMediaPack
// ============================================
model AdvertPackage {
  id                      String   @id @default(uuid())
  name                    String
  nameSlug                String   @unique @map("name_slug")
  showIds                 String[] @map("show_ids")
  advertisementsCount     Int      @map("advertisements_count")
  announcementsCount      Int      @map("announcements_count")
  popUpsCount             Int      @map("pop_ups_count")
  bonusesCount            Int      @map("bonuses_count")
  priceBeforeVAT         Float    @map("price_before_vat")
  otherTaxes              Float    @map("other_taxes")
  finalPrice              Float    @map("final_price")
  isActive                Boolean  @default(true) @map("is_active")
  advertisementsRerunCount Int     @default(0) @map("advertisements_rerun_count")
  announcementsRerunCount  Int     @default(0) @map("announcements_rerun_count")
  popUpsRerunCount        Int       @default(0) @map("pop_ups_rerun_count")
  bonusesRerunCount      Int       @default(0) @map("bonuses_rerun_count")
  description             String?
  imageUrl                String?   @map("image_url")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  showLinks               AdvertPackageShow[]
  mediaPackLinks          AdvertPackageMediaPack[]
  advertSales             AdvertSales[]

  @@index([isActive])
  @@map("advert_packages")
}

// ============================================
// ADVERT SALES - Sold advert package contracts (sales follow-up)
// ============================================
model AdvertSales {
  id                            String   @id @default(uuid())
  referenceNumber               String   @unique @map("reference_number")
  advertPackageId               String   @map("advert_package_id")
  customerId                    String   @map("customer_id")
  status                        String   // AdvertSalesStatus
  advertType                    String   @default("Paid") @map("advert_type") // Paid, Barter, FreeInKind, Production
  adStartDate                   DateTime @map("ad_start_date")
  adEndDate                     DateTime @map("ad_end_date")
  adLengthSeconds               Int      @map("ad_length_seconds")
  numOfSlots                    Int      @map("num_of_slots")
  adPackagePrice                Float    @map("ad_package_price")
  discountPercentage            Float    @default(0) @map("discount_percentage")
  finalPrice                    Float    @map("final_price")
  installmentCount              Int      @default(1) @map("installment_count")
  campaignName                  String   @map("campaign_name")
  contractSignDate              DateTime @map("contract_sign_date")
  salesRepId                    String?  @map("sales_rep_id")
  salesRepCommissionPercentage  Float    @default(0) @map("sales_rep_commission_percentage")
  categoryId                    String?  @map("category_id")
  subCategoryId                 String?  @map("sub_category_id")
  salesAgentId                  String?  @map("sales_agent_id")
  salesAgentCommissionPercentage Float   @default(0) @map("sales_agent_commission_percentage")
  festiveSeason                 String?  @map("festive_season")
  referralSource                String?  @map("referral_source")
  notes                         String?
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  advertPackage  AdvertPackage    @relation(fields: [advertPackageId], references: [id], onDelete: Restrict)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesRep       User?            @relation("AdvertSalesSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  salesAgent     User?            @relation("AdvertSalesSalesAgent", fields: [salesAgentId], references: [id], onDelete: SetNull)
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory    SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  placements       AdvertPlacement[]
  payments         Payment[]
  compensations    Compensation[]
  revenueShares    RevenueShare[]
  agentCommissions AgentCommission[]

  @@index([advertPackageId])
  @@index([customerId])
  @@index([salesRepId])
  @@index([salesAgentId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@map("advert_sales")
}

// ============================================
// ADVERT PACKAGE SHOW - Junction between AdvertPackage and Show
// ============================================
model AdvertPackageShow {
  id              String        @id @default(uuid())
  advertPackageId String        @map("advert_package_id")
  showId          String        @map("show_id")

  advertPackage   AdvertPackage @relation(fields: [advertPackageId], references: [id], onDelete: Cascade)
  show            Show          @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([advertPackageId, showId])
  @@index([showId])
  @@map("advert_package_shows")
}

// ============================================
// ADVERT PACKAGE MEDIA PACK - Junction (package ↔ many media packs)
// ============================================
model AdvertPackageMediaPack {
  id              String   @id @default(uuid())
  advertPackageId String   @map("advert_package_id")
  mediaPackId     String   @map("media_pack_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  advertPackage AdvertPackage @relation(fields: [advertPackageId], references: [id], onDelete: Cascade)
  mediaPack     MediaPack     @relation(fields: [mediaPackId], references: [id], onDelete: Cascade)

  @@unique([advertPackageId, mediaPackId])
  @@index([mediaPackId])
  @@map("advert_package_media_packs")
}

// ============================================
// TELEGRAM GROUP - Telegram notification groups
// ============================================
model TelegramGroup {
  id          String   @id @default(uuid())
  groupName   String   @map("group_name")
  groupChatId String?   @unique @map("group_chat_id")
  groupLink   String  @map("group_link")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  members TelegramGroupMember[]

  @@map("telegram_groups")
}

// ============================================
// TELEGRAM GROUP MEMBER - Junction table for User-TelegramGroup
// ============================================
model TelegramGroupMember {
  id              String   @id @default(uuid())
  telegramGroupId String   @map("telegram_group_id")
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  telegramGroup TelegramGroup @relation(fields: [telegramGroupId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([telegramGroupId, userId]) // Prevent duplicate memberships
  @@index([telegramGroupId])
  @@index([userId])
  @@map("telegram_group_members")
}


// ============================================
// PERMISSION - Permission for authorizations
// ============================================
model Permission {
  id                  String   @id @default(uuid())
  name                String
  nameSlug            String   @unique @map("name_slug")
  isSystemPermission  String? @map("is_system_permission")
  description         String?   
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  userPermissions UserPermission[]
}


// ============================================
// USER PERMISSION - Junction table for User-Permission
// ============================================
model UserPermission {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  permissionId    String   @map("permission_id")
  grantedBy       String?  @map("granted_by")
  expiresAt       DateTime?   @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user          User          @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser User?         @relation("PermissionGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([permissionId, userId]) // Prevent duplicate permissions
  @@index([permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// ============================================
// REVENUE SHARE - Revenue distribution to partners for outsourced shows
// ============================================
model RevenueShare {
  id               String    @id @default(uuid())
  advertSalesId    String    @map("advert_sales_id")
  partnerId        String    @map("partner_id")
  showHostId       String?   @map("show_host_id")
  sharePercentage  Float     @map("share_percentage")
  shareAmount      Float     @map("share_amount")
  status           String    @default("PENDING") // PENDING, DISBURSED
  disbursedDate    DateTime? @map("disbursed_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  advertSales AdvertSales @relation(fields: [advertSalesId], references: [id], onDelete: Cascade)
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([advertSalesId])
  @@index([partnerId])
  @@map("revenue_shares")
}

// ============================================
// AGENT COMMISSION - Sales agent commissions
// ============================================
model AgentCommission {
  id                   String    @id @default(uuid())
  advertSalesId        String    @map("advert_sales_id")
  agentId              String    @map("agent_id")
  commissionPercentage Float     @map("commission_percentage")
  commissionAmount     Float     @map("commission_amount")
  taxAmount            Float     @default(0) @map("tax_amount")
  netAmount            Float     @default(0) @map("net_amount")
  status               String    @default("PENDING") // PENDING, DISBURSED
  disbursedDate        DateTime? @map("disbursed_date")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  advertSales AdvertSales @relation(fields: [advertSalesId], references: [id], onDelete: Cascade)
  agent       User        @relation("AgentCommissions", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([advertSalesId])
  @@index([agentId])
  @@map("agent_commissions")
}