{
	"info": {
		"_postman_id": "tv-system-api",
		"name": "TV System API",
		"description": "Abbay TV sales automation backend API endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "health"]
						},
						"description": "Check API health status"
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', response.accessToken);",
									"    pm.collectionVariables.set('refreshToken', response.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"John Doe\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Register a new user. Returns access token and refresh token. User is automatically assigned SalesRep role."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', response.accessToken);",
									"    pm.collectionVariables.set('refreshToken', response.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login with email and password. Returns access token and refresh token."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "refresh"]
						},
						"description": "Refresh access token using refresh token"
					},
					"response": []
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/users/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "me"]
						},
						"description": "Get current authenticated user information"
					},
					"response": []
				},
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@example.com\",\n  \"fullName\": \"John Doe\",\n  \"password\": \"password123\",\n  \"roles\": [\"SalesRep\"],\n  \"permissions\": [],\n  \"isActive\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/users",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users"]
						},
						"description": "Create a new user. Requires MANAGE_USERS permission."
					},
					"response": []
				},
				{
					"name": "Request Password Reset",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "reset-password"]
						},
						"description": "Request password reset email"
					},
					"response": []
				},
				{
					"name": "Set User Active",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isActive\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/:userId/active",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", ":userId", "active"],
							"variable": [
								{
									"key": "userId",
									"value": "",
									"type": "string"
								}
							]
						},
						"description": "Set user active/inactive status. Requires MANAGE_USERS permission."
					},
					"response": []
				}
			]
		},
		{
			"name": "Shows",
			"item": [
				{
					"name": "List Shows",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/shows",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shows"]
						},
						"description": "Get list of all shows"
					},
					"response": []
				},
				{
					"name": "Create Show",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Morning Show\",\n  \"type\": \"InHouse\",\n  \"durationMinutes\": 120,\n  \"maxAdLengthSeconds\": 30,\n  \"schedule\": [\n    {\n      \"day\": \"Monday\",\n      \"startTime\": \"08:00\",\n      \"endTime\": \"10:00\"\n    }\n  ],\n  \"assignedStaff\": \"staff-id-optional\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/shows",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shows"]
						},
						"description": "Create a new show. Requires MANAGE_SHOWS permission. Show type can be 'InHouse' or 'Outsourced'."
					},
					"response": []
				}
			]
		},
		{
			"name": "Adverts",
			"item": [
				{
					"name": "Create Advert",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"showId\": \"show-id-here\",\n  \"customerId\": \"customer-id-here\",\n  \"slot\": {\n    \"start\": \"2024-01-01T10:00:00.000Z\",\n    \"end\": \"2024-01-01T10:30:00.000Z\"\n  },\n  \"contractDetails\": \"Contract details here\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/adverts",
							"host": ["{{baseUrl}}"],
							"path": ["api", "adverts"]
						},
						"description": "Create a new advertisement. Requires MANAGE_ADVERTS permission."
					},
					"response": []
				}
			]
		},
		{
			"name": "Finance",
			"item": [
				{
					"name": "Create Payment Request",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"advertId\": \"advert-id-here\",\n  \"installmentLabel\": \"First Installment\",\n  \"amount\": 5000,\n  \"currency\": \"ETB\",\n  \"dueDate\": \"2024-01-15T00:00:00.000Z\",\n  \"customerEmail\": \"customer@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/finance/payments",
							"host": ["{{baseUrl}}"],
							"path": ["api", "finance", "payments"]
						},
						"description": "Create a payment request. Requires MANAGE_FINANCE permission."
					},
					"response": []
				}
			]
		},
		{
			"name": "Compensations",
			"item": [
				{
					"name": "Propose Compensation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"advertId\": \"advert-id-here\",\n  \"proposal\": \"Compensation proposal details\",\n  \"customerEmail\": \"customer@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/compensations",
							"host": ["{{baseUrl}}"],
							"path": ["api", "compensations"]
						},
						"description": "Propose compensation for an advert. Requires MANAGE_ADVERTS permission."
					},
					"response": []
				}
			]
		},
		{
			"name": "Analytics",
			"item": [
				{
					"name": "Get Analytics Summary",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/analytics/summary",
							"host": ["{{baseUrl}}"],
							"path": ["api", "analytics", "summary"]
						},
						"description": "Get analytics summary including sales by show. Requires VIEW_ANALYTICS permission."
					},
					"response": []
				}
			]
		}
	]
}
